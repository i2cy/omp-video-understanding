+/** Serialize the complete read/merge/write transaction across processes. */
+export async function updatePluginRuntimeConfig(
+	lockPath: string,
+	baseline: PluginRuntimeConfig,
+	local: PluginRuntimeConfig,
+): Promise<PluginRuntimeConfig> {
+	await fs.mkdir(path.dirname(lockPath), { recursive: true });
+	return withFileLock(lockPath, async () => {
+		const current = await readPluginRuntimeConfig(lockPath);
+		const merged = mergePluginRuntimeConfig(baseline, local, current);
+		await writeConfigAtomically(lockPath, merged);
+		return merged;
+	});
