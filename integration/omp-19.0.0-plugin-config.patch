+ * key so independent nested edits survive; arrays and scalars are atomic.
+ */
+function mergeRuntimeConfigValue(baseline: unknown, local: unknown, current: unknown): unknown {
+	if (local === undefined) {
+		return baseline === undefined ? current : undefined;
+	}
+	if (baseline !== undefined && isDeepStrictEqual(local, baseline)) return current;
+	if (isJsonObject(local) && (current === undefined || isJsonObject(current))) {
+		const baselineObject = isJsonObject(baseline) ? baseline : {};
+		const currentObject = isJsonObject(current) ? current : {};
+		const result: JsonObject = {};
+		const keys = new Set([...Object.keys(baselineObject), ...Object.keys(local), ...Object.keys(currentObject)]);
+		for (const key of keys) {
+			const value = mergeRuntimeConfigValue(baselineObject[key], local[key], currentObject[key]);
+			if (value !== undefined) result[key] = value;
+		}
+		return result;
+	}
+	return local;
