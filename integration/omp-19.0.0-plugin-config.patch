+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { getPluginsLockfile, getProjectPluginOverridesPath, refreshDirsFromEnv } from "@oh-my-pi/pi-utils";
+import { PluginManager } from "./manager";
+import type { PluginRuntimeConfig } from "./types";
+
+const originalXdgDataHome = process.env.XDG_DATA_HOME;
+let tempDir: string;
+
+function initialConfig(): PluginRuntimeConfig {
+	return {
+		plugins: {
+			alpha: { version: "1.0.0", enabledFeatures: ["one"], enabled: true },
+			beta: { version: "2.0.0", enabledFeatures: null, enabled: true },
+		},
+		settings: {
+			alpha: { untouched: "keep", shared: "initial" },
+			beta: { nested: { left: 1, right: 2 } },
+		},
+	};
+}
+
+async function writeInitialConfig(config: PluginRuntimeConfig = initialConfig()): Promise<void> {
+	const lockPath = getPluginsLockfile();
+	await fs.mkdir(path.dirname(lockPath), { recursive: true });
+	await fs.writeFile(lockPath, JSON.stringify(config), { mode: 0o600 });
+}
+
+async function readConfig(): Promise<PluginRuntimeConfig> {
+	return JSON.parse(await fs.readFile(getPluginsLockfile(), "utf8"));
+}
+
+beforeEach(async () => {
+	tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "omp-plugin-config-lock-"));
+	process.env.XDG_DATA_HOME = tempDir;
+	// DirResolver only uses an XDG path once the application root exists.
+	await fs.mkdir(path.join(tempDir, "omp"), { recursive: true });
+	refreshDirsFromEnv();
+});
+
+afterEach(async () => {
+	if (originalXdgDataHome === undefined) delete process.env.XDG_DATA_HOME;
+	else process.env.XDG_DATA_HOME = originalXdgDataHome;
+	refreshDirsFromEnv();
+	await fs.rm(tempDir, { recursive: true, force: true });
+});
+
+describe("PluginManager runtime config persistence", () => {
+	test("merges independent managers' nested edits and repeated writes without losing unchanged fields", async () => {
+		await writeInitialConfig();
+		const first = new PluginManager(tempDir);
+		const second = new PluginManager(tempDir);
+		await Promise.all([first.getPluginSettings("alpha"), second.getPluginSettings("beta")]);
+
+		await Promise.all([
+			first.setEnabled("alpha", false),
+			second.setEnabledFeatures("alpha", null),
+			second.setEnabled("beta", false),
+		]);
+		for (let round = 0; round < 5; round++) {
+			await Promise.all([
+				first.setPluginSetting("alpha", "fromFirst", { round }),
+				second.setPluginSetting("beta", "fromSecond", `second-${round}`),
+			]);
+		}
+
+		const saved = await readConfig();
+		expect(saved).toEqual({
+			plugins: {
+				alpha: { version: "1.0.0", enabledFeatures: null, enabled: false },
+				beta: { version: "2.0.0", enabledFeatures: null, enabled: false },
+			},
+			settings: {
+				alpha: { untouched: "keep", shared: "initial", fromFirst: { round: 4 } },
+				beta: { nested: { left: 1, right: 2 }, fromSecond: "second-4" },
+			},
+		});
+		expect((await fs.stat(getPluginsLockfile())).mode & 0o777).toBe(0o600);
+	});
+
+	test("uses lock-order last-writer-wins for the same field", async () => {
+		await writeInitialConfig();
+		const first = new PluginManager(tempDir);
+		const second = new PluginManager(tempDir);
+		await Promise.all([first.getPluginSettings("alpha"), second.getPluginSettings("alpha")]);
+
+		await first.setPluginSetting("alpha", "shared", "first");
+		await second.setPluginSetting("alpha", "shared", "second");
+
+		expect((await readConfig()).settings.alpha.shared).toBe("second");
+	});
+
+	test("does not resurrect a deletion when another manager adds a setting", async () => {
+		await writeInitialConfig();
+		const first = new PluginManager(tempDir);
+		const second = new PluginManager(tempDir);
+		await Promise.all([first.getPluginSettings("alpha"), second.getPluginSettings("alpha")]);
+
+		await first.deletePluginSetting("alpha", "untouched");
+		await second.setPluginSetting("alpha", "externalAddition", true);
+
+		expect((await readConfig()).settings.alpha).toEqual({ shared: "initial", externalAddition: true });
+	});
+
+	test("keeps project settings isolated and reveals global values after local deletion", async () => {
+		await writeInitialConfig();
+		const manager = new PluginManager(tempDir);
+		await manager.setPluginSetting("alpha", "shared", "global");
+		await manager.setPluginSetting("alpha", "globalOnly", "global-only");
+		await manager.setPluginSetting("alpha", "shared", "project", true);
+		await manager.setPluginSetting("alpha", "localOnly", "project-only", true);
+
+		expect(await manager.getPluginSettings("alpha")).toEqual({
+			untouched: "keep",
+			shared: "project",
+			globalOnly: "global-only",
+			localOnly: "project-only",
+		});
+		expect((await readConfig()).settings.alpha).toEqual({
+			untouched: "keep",
+			shared: "global",
+			globalOnly: "global-only",
+		});
+
+		await manager.deletePluginSetting("alpha", "shared", true);
+		expect((await manager.getPluginSettings("alpha")).shared).toBe("global");
+	});
+
+	test("locks project override read-modify-write across independent managers", async () => {
+		await writeInitialConfig();
+		const first = new PluginManager(tempDir);
+		const second = new PluginManager(tempDir);
+		await first.setPluginSetting("alpha", "obsolete", true, true);
+
+		for (let round = 0; round < 5; round++) {
+			await Promise.all([
+				first.setPluginSetting("alpha", "fromFirst", round, true),
+				second.setPluginSetting("alpha", "fromSecond", round, true),
+			]);
+		}
+		await Promise.all([
+			first.deletePluginSetting("alpha", "obsolete", true),
+			second.setPluginSetting("alpha", "externalAddition", "project", true),
+		]);
+
+		const overridesPath = getProjectPluginOverridesPath(tempDir);
+		const overrides = JSON.parse(await fs.readFile(overridesPath, "utf8"));
+		expect(overrides.settings.alpha).toEqual({ fromFirst: 4, fromSecond: 4, externalAddition: "project" });
+		expect((await fs.stat(overridesPath)).mode & 0o777).toBe(0o600);
+		expect((await readConfig()).settings.alpha).toEqual({ untouched: "keep", shared: "initial" });
+	});
+
+	test("refuses to overwrite malformed JSON with an empty config", async () => {
+		const lockPath = getPluginsLockfile();
+		await fs.mkdir(path.dirname(lockPath), { recursive: true });
+		const malformed = '{"plugins":';
+		await fs.writeFile(lockPath, malformed, { mode: 0o600 });
+		const manager = new PluginManager(tempDir);
+
+		await expect(manager.setPluginSetting("alpha", "newValue", true)).rejects.toThrow();
+		expect(await fs.readFile(lockPath, "utf8")).toBe(malformed);
+	});
+});
