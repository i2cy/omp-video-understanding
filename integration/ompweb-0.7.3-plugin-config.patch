index 0000000..3ede758
--- /dev/null
+++ b/lib/omp/plugin-config.test.mjs
@@ -0,0 +1,94 @@
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import {
+  MAX_PLUGIN_ACTION_RESPONSE_BYTES,
+  executePluginAction,
+  publicPluginActions,
+  publicPluginSchema,
+  publicPluginSettings,
+  serializePluginActionPayload,
+  serializePluginWrite,
+  validatePluginSettings,
+  validateSecretClears,
+} from "./plugin-config.ts";
+
+const schema = {
+  name: { type: "string", default: "demo" },
+  retries: { type: "number", min: 1, max: 3 },
+  enabled: { type: "boolean", default: true },
+  mode: { type: "enum", values: ["fast", "safe"] },
+  token: { type: "string", secret: true, default: "must-not-leak" },
+};
+
+test("all manifest scalar types use OMP-equivalent validation and reject unknown keys before writes", () => {
+  assert.deepEqual(validatePluginSettings(schema, { name: "ok", retries: 2, enabled: false, mode: "safe" }), []);
+  const errors = validatePluginSettings(schema, { name: 1, retries: 4, enabled: "true", mode: "other", extra: "x" });
+  assert.deepEqual(errors.map(({ key, code }) => ({ key, code })), [
+    { key: "name", code: "invalid_setting" },
+    { key: "retries", code: "invalid_setting" },
+    { key: "enabled", code: "invalid_setting" },
+    { key: "mode", code: "invalid_setting" },
+    { key: "extra", code: "unknown_setting" },
+  ]);
+  assert.deepEqual(validatePluginSettings(schema, { token: "" }, { preserveBlankSecrets: true }), []);
+  assert.deepEqual(validateSecretClears(schema, ["name", "missing"]).map((error) => error.code), ["not_a_secret", "unknown_setting"]);
+});
+
+test("public settings redact secrets and secret defaults while exposing ordinary defaults", () => {
+  const publicSchema = publicPluginSchema(schema);
+  assert.equal(Object.hasOwn(publicSchema.token, "default"), false);
+  assert.equal(publicSchema.name.default, "demo");
+  assert.deepEqual(publicPluginSettings(publicSchema, { retries: 2, token: "raw-secret" }), {
+    name: "demo",
+    retries: 2,
+    enabled: true,
+    token: { configured: true, redacted: true },
+  });
+  assert.deepEqual(publicPluginSettings(publicSchema, {}).token, { configured: false, redacted: true });
+  assert.deepEqual(publicPluginActions({ check: { module: "./private.ts", export: "run", description: "Check" } }), { check: { description: "Check" } });
+});
+
+test("writes for one scope are serial, including after a failure", async () => {
+  const events = [];
+  const operation = (name, fail = false) => serializePluginWrite("project", "/workspace", async () => {
+    events.push(`${name}:start`);
+    await new Promise((resolve) => setTimeout(resolve, name === "first" ? 15 : 1));
+    events.push(`${name}:end`);
+    if (fail) throw new Error("failure");
+  });
+  const first = operation("first", true);
+  const second = operation("second");
+  await assert.rejects(first, /failure/);
+  await second;
+  assert.deepEqual(events, ["first:start", "first:end", "second:start", "second:end"]);
+});
+
+test("a manifest action executes the installed module with cwd and signal, never a caller-selected module", async () => {
+  const parent = mkdtempSync(join(tmpdir(), "omp-web-plugin-action-"));
+  const root = join(parent, "package");
+  mkdirSync(root);
+  try {
+    writeFileSync(join(root, "action.mjs"), "export async function declared(cwd, signal) { return { source: 'installed-plugin', cwd, hasSignal: signal instanceof AbortSignal }; }\n");
+    const controller = new AbortController();
+    const result = await executePluginAction(root, { module: "./action.mjs", export: "declared" }, "/allowed/workspace", controller.signal);
+    assert.deepEqual(result, { source: "installed-plugin", cwd: "/allowed/workspace", hasSignal: true });
+
+    const parentAction = join(parent, "outside-action.mjs");
+    writeFileSync(parentAction, "export function declared() { return { forbidden: true }; }\n");
+    await assert.rejects(executePluginAction(root, { module: parentAction, export: "declared" }, "/allowed/workspace"), /outside the package root/);
+    rmSync(parentAction, { force: true });
+  } finally {
+    rmSync(parent, { recursive: true, force: true });
+  }
+});
+
+test("action results must be bounded JSON", () => {
+  const cyclic = {};
+  cyclic.self = cyclic;
+  assert.throws(() => serializePluginActionPayload(cyclic), /non-JSON/);
+  assert.throws(() => serializePluginActionPayload({ text: "x".repeat(MAX_PLUGIN_ACTION_RESPONSE_BYTES) }), /bounded JSON/);
+  assert.equal(serializePluginActionPayload({ ok: true }), '{"ok":true}');
+});
diff --git a/lib/omp/plugin-config.ts b/lib/omp/plugin-config.ts
new file mode 100644
index 0000000..958bdbc
--- /dev/null
+++ b/lib/omp/plugin-config.ts
@@ -0,0 +1,165 @@
+import { realpath } from "node:fs/promises";
+import { isAbsolute, relative, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import type {
+  PluginActionInfo,
+  PluginConfigValidationError,
+  PluginSecretState,
+  PluginSettingSchema,
+  PluginSettingValue,
+} from "@/lib/api-types";
+
+export const MAX_PLUGIN_ACTION_RESPONSE_BYTES = 256 * 1024;
+
+export interface OmpActionDeclaration {
+  module: string;
+  export: string;
+  description?: string;
+}
+
+/** Only schema is public. In particular, a secret's default is a value too and
+ * must not cross the server boundary. Action module/export names stay on the
+ * server: the browser needs only the declared id and description. */
+export function publicPluginSchema(schema: Record<string, PluginSettingSchema> | undefined): Record<string, PluginSettingSchema> {
+  return Object.fromEntries(Object.entries(schema ?? {}).map(([key, setting]) => {
+    const safe = { ...setting };
+    if (safe.secret) delete safe.default;
+    return [key, safe];
+  }));
+}
+
+export function publicPluginActions(actions: Record<string, OmpActionDeclaration> | undefined): Record<string, PluginActionInfo> {
+  return Object.fromEntries(Object.entries(actions ?? {}).map(([id, action]) => [id, { description: action.description }]));
+}
+
+/** Mirrors omp's validateSetting for the four manifest scalar types. Unknown
+ * request keys are rejected separately, before any CLI write is started. */
+export function validatePluginSettings(
+  schema: Record<string, PluginSettingSchema>,
+  values: Record<string, unknown>,
+  options: { preserveBlankSecrets?: boolean } = {},
+): PluginConfigValidationError[] {
+  const errors: PluginConfigValidationError[] = [];
+  for (const [key, value] of Object.entries(values)) {
+    const setting = Object.hasOwn(schema, key) ? schema[key] : undefined;
+    if (!setting) {
+      errors.push({ key, code: "unknown_setting", message: "Unknown setting" });
+      continue;
+    }
+    if (options.preserveBlankSecrets && setting.secret && value === "") continue;
+
+    let message: string | undefined;
+    switch (setting.type) {
+      case "string":
+        if (typeof value !== "string") message = "Expected string";
+        break;
+      case "number":
+        if (typeof value !== "number" || Number.isNaN(value)) message = "Expected number";
+        else if (setting.min !== undefined && value < setting.min) message = `Must be >= ${setting.min}`;
+        else if (setting.max !== undefined && value > setting.max) message = `Must be <= ${setting.max}`;
+        break;
+      case "boolean":
+        if (typeof value !== "boolean") message = "Expected boolean";
+        break;
+      case "enum":
+        if (!setting.values.includes(String(value))) message = `Must be one of: ${setting.values.join(", ")}`;
+        break;
+    }
+    if (message) errors.push({ key, code: "invalid_setting", message });
+  }
+  return errors;
+}
+
+export function validateSecretClears(
+  schema: Record<string, PluginSettingSchema>,
+  keys: string[],
+): PluginConfigValidationError[] {
+  const errors: PluginConfigValidationError[] = [];
+  for (const key of keys) {
+    const setting = Object.hasOwn(schema, key) ? schema[key] : undefined;
+    if (!setting) errors.push({ key, code: "unknown_setting", message: "Unknown setting" });
+    else if (!setting.secret) errors.push({ key, code: "not_a_secret", message: "Only secret settings can be cleared" });
+  }
+  return errors;
+}
+
+/** Raw values never leave this function for secret keys. Defaults are exposed
+ * only for non-secret settings, matching `omp plugin config list` display. */
+export function publicPluginSettings(
+  schema: Record<string, PluginSettingSchema>,
+  raw: Record<string, unknown>,
+): Record<string, PluginSettingValue | PluginSecretState> {
+  const entries: Array<[string, PluginSettingValue | PluginSecretState]> = [];
+  for (const [key, setting] of Object.entries(schema)) {
+    if (setting.secret) {
+      entries.push([key, {
+        configured: Object.hasOwn(raw, key) && raw[key] !== undefined && raw[key] !== null && raw[key] !== "",
+        redacted: true,
+      }]);
+      continue;
+    }
+    const value = Object.hasOwn(raw, key) ? raw[key] : setting.default;
+    if (typeof value === "string" || typeof value === "number" || typeof value === "boolean") entries.push([key, value]);
+  }
+  return Object.fromEntries(entries);
+}
+
+// A scope owns a runtime configuration file. Serializing by scope (rather than
+// by plugin) prevents two Web requests for different plugins from interleaving.
+// This is deliberately only the Web-side queue; omp's own lock remains the
+// authority for coordination with external CLI processes.
+const writeTails = new Map<string, Promise<void>>();
+
+export async function serializePluginWrite<T>(scope: "global" | "project", cwd: string | null, operation: () => Promise<T>): Promise<T> {
+  const key = scope === "global" ? "global" : `project:${cwd ?? ""}`;
+  const previous = writeTails.get(key) ?? Promise.resolve();
+  const run = previous.catch(() => {}).then(operation);
+  const tail = run.then(() => undefined, () => undefined);
+  writeTails.set(key, tail);
+  try {
+    return await run;
+  } finally {
+    if (writeTails.get(key) === tail) writeTails.delete(key);
+  }
+}
+
+function withinRoot(root: string, candidate: string): boolean {
+  const rel = relative(root, candidate);
+  return rel !== "" && rel !== ".." && !rel.startsWith(`..${process.platform === "win32" ? "\\" : "/"}`) && !isAbsolute(rel);
+}
+
+/** Resolve and execute only an action declaration read from the installed
+ * package manifest. Neither the module nor the export is request-controlled. */
+export async function executePluginAction(
+  packageRoot: string,
+  declaration: OmpActionDeclaration,
+  cwd: string,
+  signal?: AbortSignal,
+): Promise<unknown> {
+  if (!declaration || typeof declaration.module !== "string" || !declaration.module || typeof declaration.export !== "string" || !declaration.export) {
+    throw new Error("Invalid plugin action declaration");
+  }
+  signal?.throwIfAborted();
+  const root = await realpath(packageRoot);
+  const modulePath = await realpath(resolve(root, declaration.module));
+  if (!withinRoot(root, modulePath)) throw new Error("Plugin action module is outside the package root");
+  // Runtime plugin registry: a static import cannot name an installed package's manifest-selected action module.
+  const loaded = await import(pathToFileURL(modulePath).href) as Record<string, unknown>;
+  const action = Object.hasOwn(loaded, declaration.export) ? loaded[declaration.export] : undefined;
+  if (typeof action !== "function") throw new Error("Plugin action export is not a function");
+  signal?.throwIfAborted();
+  return await (action as (cwd: string, signal?: AbortSignal) => unknown)(cwd, signal);
+}
+
+export function serializePluginActionPayload(payload: unknown): string {
+  let json: string | undefined;
+  try {
+    json = JSON.stringify(payload);
+  } catch {
+    throw new Error("Plugin action returned a non-JSON result");
+  }
+  if (json === undefined || Buffer.byteLength(json, "utf8") > MAX_PLUGIN_ACTION_RESPONSE_BYTES) {
+    throw new Error("Plugin action result is not bounded JSON");
+  }
+  return json;
+}
diff --git a/lib/omp/plugin-management.test.mjs b/lib/omp/plugin-management.test.mjs
new file mode 100644
index 0000000..21e1f5c
--- /dev/null
+++ b/lib/omp/plugin-management.test.mjs
@@ -0,0 +1,27 @@
+import assert from "node:assert/strict";
+import { chmod, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import test from "node:test";
+import { runOmp } from "./plugin-management.ts";
+
+test("plugin configuration can use an independent OMP without replacing the chat runner", async () => {
+  const directory = await mkdtemp(path.join(tmpdir(), "omp-plugin-runner-"));
+  const executable = path.join(directory, "plugin-omp");
+  const previousPluginBin = process.env.OMP_WEB_PLUGIN_OMP_BIN;
+  const previousRunnerBin = process.env.OMP_WEB_OMP_BIN;
+  try {
+    await writeFile(executable, "#!/usr/bin/env node\nconsole.log(JSON.stringify({ args: process.argv.slice(2), cwd: process.cwd() }));\n", { mode: 0o700 });
+    await chmod(executable, 0o700);
+    process.env.OMP_WEB_PLUGIN_OMP_BIN = executable;
+    process.env.OMP_WEB_OMP_BIN = path.join(directory, "chat-runner-must-not-be-used");
+    const { stdout } = await runOmp(["plugin", "config", "validate"], { cwd: directory });
+    assert.deepEqual(JSON.parse(stdout), { args: ["plugin", "config", "validate"], cwd: directory });
+  } finally {
+    if (previousPluginBin === undefined) delete process.env.OMP_WEB_PLUGIN_OMP_BIN;
+    else process.env.OMP_WEB_PLUGIN_OMP_BIN = previousPluginBin;
+    if (previousRunnerBin === undefined) delete process.env.OMP_WEB_OMP_BIN;
+    else process.env.OMP_WEB_OMP_BIN = previousRunnerBin;
+    await rm(directory, { recursive: true, force: true });
+  }
+});
